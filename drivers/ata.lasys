; ------------------------------------------------------------------
; floppy.lasys - Minimal LBA28 ATA PIO Block Driver
; ------------------------------------------------------------------

%ifndef ATA_LASYS
%define ATA_LASYS

global floppy_read_sector
global floppy_write_sector
global floppy_probe

msg_floppy_err db "ATA read/write error", 0x0A, 0
ata_present dd 0
ata_last_status dd 0

floppy_probe:
    push edx
    mov edx, 0x1F7
    in al, dx
    cmp al, 0xFF
    jne .present
    mov dword [ata_present], 0
    xor eax, eax
    pop edx
    ret
.present:
    mov dword [ata_present], 1
    mov eax, 1
    pop edx
    ret


; Input: EAX = LBA Sector, EBX = Memory Buffer
floppy_read_sector:
    pusha
    mov ecx, eax            ; Save LBA

    ; Select Drive and LBA High
    mov edx, 0x1F6
    shr eax, 24
    or al, 0xE0             ; Master drive, LBA mode
    out dx, al

    ; Sector count (1)
    mov edx, 0x1F2
    mov al, 1
    out dx, al

    ; LBA Low, Mid, High
    mov eax, ecx
    mov edx, 0x1F3
    out dx, al
    mov edx, 0x1F4
    shr eax, 8
    out dx, al
    mov edx, 0x1F5
    shr eax, 8
    out dx, al

    ; Command: Read with Retry
    mov edx, 0x1F7
    mov al, 0x20
    out dx, al

    mov ecx, 0x100000
.wait:
    in al, dx
    test al, 0x80           ; Wait while BSY
    jnz .wait_next
    test al, 1              ; Check ERR bit
    jnz .error
    test al, 8              ; Check DRQ bit (Ready to transfer)
    jnz .read
.wait_next:
    loop .wait
    jmp .error

.read:
    mov edx, 0x1F0
    mov ecx, 256            ; Read 256 words (512 bytes)
    mov edi, ebx
    rep insw
    mov dword [ata_last_status], 1
    popa
    mov eax, 1
    ret

.error:
    mov dword [ata_last_status], 0
    mov esi, msg_floppy_err
    call api_print_string
    popa
    xor eax, eax
    ret

; Input: EAX = LBA Sector, EBX = Memory Buffer
floppy_write_sector:
    pusha
    mov ecx, eax

    mov edx, 0x1F6
    shr eax, 24
    or al, 0xE0
    out dx, al

    mov edx, 0x1F2
    mov al, 1
    out dx, al

    mov eax, ecx
    mov edx, 0x1F3
    out dx, al
    mov edx, 0x1F4
    shr eax, 8
    out dx, al
    mov edx, 0x1F5
    shr eax, 8
    out dx, al

    mov edx, 0x1F7
    mov al, 0x30
    out dx, al

    mov ecx, 0x100000
.wait:
    in al, dx
    test al, 0x80
    jnz .wait_next
    test al, 1
    jnz .error
    test al, 8
    jnz .write
.wait_next:
    loop .wait
    jmp .error

.write:
    mov edx, 0x1F0
    mov ecx, 256
    mov esi, ebx
    rep outsw           ; Enviamos los 512 bytes al disco
    
    ; --- NUEVO: Esperar a que el disco procese los datos ---
    mov edx, 0x1F7
    mov ecx, 0x100000
.wait_write_finish:
    in al, dx
    test al, 0x80       ; Comprobar BSY (Busy)
    jz .flush
    loop .wait_write_finish
    jmp .error
.flush:
    ; Flush Cache (0xE7) y esperar con timeout
    mov al, 0xE7
    out dx, al
    mov ecx, 0x100000
.wait_flush:
    in al, dx
    test al, 0x80       ; Comprobar BSY de nuevo
    jz .write_ok
    loop .wait_flush
    jmp .error
.write_ok:
    mov dword [ata_last_status], 1
    popa
    mov eax, 1
    ret

.error:
    mov dword [ata_last_status], 0
    mov esi, msg_floppy_err
    call api_print_string
    popa
    xor eax, eax
    ret
%endif
