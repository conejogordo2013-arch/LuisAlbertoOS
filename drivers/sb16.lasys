; ------------------------------------------------------------------
; sb16.lasys - Deteccion minima Sound Blaster 16 (stub real)
; ------------------------------------------------------------------

%ifndef SB16_LASYS
%define SB16_LASYS

sb16_probe:
    ; Detección mínima DSP reset en puerto base 0x220.
    push edx
    mov dx, 0x226
    mov al, 1
    out dx, al
    mov ecx, 2000
.d1:
    loop .d1
    xor al, al
    out dx, al
    mov ecx, 20000
    mov dx, 0x22E
.wait:
    in al, dx
    test al, 0x80
    jnz .ready
    loop .wait
    mov dword [sb16_present], 0
    pop edx
    xor eax, eax
    ret
.ready:
    mov dx, 0x22A
    in al, dx
    cmp al, 0xAA
    jne .not_found
    mov dword [sb16_present], 1
    pop edx
    mov eax, 1
    ret
.not_found:
    mov dword [sb16_present], 0
    pop edx
    xor eax, eax
    ret

sb16_wait_write:
    push ecx
    push edx
    mov dx, 0x22C
    mov ecx, 0x10000
.wait:
    in al, dx
    test al, 0x80
    jz .ok
    loop .wait
.ok:
    pop edx
    pop ecx
    ret

sb16_write_dsp:
    ; AL = comando DSP
    push eax
    call sb16_wait_write
    mov dx, 0x22C
    pop eax
    out dx, al
    ret

sb16_beep:
    cmp dword [sb16_present], 1
    jne .done
    pusha
    mov al, 0xD1            ; speaker on
    call sb16_write_dsp
    mov ecx, 0x1FFFF
.delay:
    loop .delay
    mov al, 0xD3            ; speaker off
    call sb16_write_dsp
    popa
.done:
    ret

%endif
