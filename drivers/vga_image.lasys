; ==================================================================
; vga_image.lasys - Driver VGA y Visualizador BMP para LuisAlbertoOS
; ==================================================================

%ifndef VGA_IMAGE_LASYS
%define VGA_IMAGE_LASYS

VGA_VRAM    equ 0xA0000
BMP_LOAD_AD equ 0x7000  ; Definido como APP_POINTER en fs.lasys
desk_cmd_min    dd 0
desk_prev_left  dd 0
desk_prev_right dd 0
desk_dragging   dd 0
desk_start_open dd 0
desk_app_explorer dd 0
desk_app_editor   dd 0
desk_app_taskmgr  dd 0
desk_win_x      dd 24
desk_win_y      dd 18
desk_win_w      dd 272
desk_win_h      dd 130

vga_desktop_view:
    mov esi, vga_regs_13h
    call vga_write_regs
.frame:
    call vga_wait_vsync

    mov eax, [mouse_buttons]
    and eax, 1
    mov ebx, [desk_prev_left]
    mov [desk_prev_left], eax
    mov ecx, [mouse_x]
    mov edx, [mouse_y]

    cmp eax, 1
    jne .drag_release
    cmp ebx, 0
    jne .drag_step

    ; Boton inicio "LAOS" (x:4..52, y:189..198)
    cmp ecx, 4
    jb .left_click_logic
    cmp ecx, 52
    ja .left_click_logic
    cmp edx, 189
    jb .left_click_logic
    cmp edx, 198
    ja .left_click_logic
    xor dword [desk_start_open], 1
    jmp .drag_step

.left_click_logic:
    cmp dword [desk_start_open], 1
    jne .cmd_minmax
    ; Menu inicio: apps + reboot/shutdown/text mode
    ; area x:4..156, y:116..186
    cmp ecx, 4
    jb .cmd_minmax
    cmp ecx, 156
    ja .cmd_minmax
    cmp edx, 116
    jb .cmd_minmax
    cmp edx, 186
    ja .cmd_minmax
    cmp edx, 126
    jbe .menu_cmd
    cmp edx, 138
    jbe .menu_explorer
    cmp edx, 150
    jbe .menu_editor
    cmp edx, 162
    jbe .menu_taskmgr
    cmp edx, 162
    jbe .menu_reboot
    cmp edx, 174
    jbe .menu_shutdown
    jmp .exit_desktop
.menu_cmd:
    mov dword [desk_cmd_min], 0
    mov dword [desk_start_open], 0
    jmp .drag_step
.menu_explorer:
    xor dword [desk_app_explorer], 1
    mov dword [desk_start_open], 0
    jmp .drag_step
.menu_editor:
    xor dword [desk_app_editor], 1
    mov dword [desk_start_open], 0
    jmp .drag_step
.menu_taskmgr:
    xor dword [desk_app_taskmgr], 1
    mov dword [desk_start_open], 0
    jmp .drag_step
.menu_reboot:
    mov al, 0xFE
    out 0x64, al
    jmp .drag_step
.menu_shutdown:
    cli
.halt_loop:
    hlt
    jmp .halt_loop

.cmd_minmax:

    ; Botón minimizar (_)
    mov esi, [desk_win_x]
    add esi, 244
    cmp ecx, esi
    jb .chk_max
    add esi, 15
    cmp ecx, esi
    ja .chk_max
    mov esi, [desk_win_y]
    add esi, 2
    cmp edx, esi
    jb .chk_max
    add esi, 10
    cmp edx, esi
    ja .chk_max
    xor dword [desk_cmd_min], 1
    jmp .drag_step
.chk_max:
    ; Botón maximizar ([]): alterna tamaño (CMD no tiene cerrar)
    mov esi, [desk_win_x]
    add esi, 262
    cmp ecx, esi
    jb .chk_drag
    add esi, 12
    cmp ecx, esi
    ja .chk_drag
    mov esi, [desk_win_y]
    add esi, 2
    cmp edx, esi
    jb .chk_drag
    add esi, 10
    cmp edx, esi
    ja .chk_drag
    cmp dword [desk_win_x], 2
    jne .set_max
    mov dword [desk_win_x], 24
    mov dword [desk_win_y], 18
    mov dword [desk_win_w], 272
    mov dword [desk_win_h], 130
    jmp .drag_step
.set_max:
    mov dword [desk_win_x], 2
    mov dword [desk_win_y], 2
    mov dword [desk_win_w], 316
    mov dword [desk_win_h], 182
    jmp .drag_step
.chk_drag:
    ; Drag de barra de título
    mov esi, [desk_win_x]
    cmp ecx, esi
    jb .drag_step
    add esi, [desk_win_w]
    cmp ecx, esi
    ja .drag_step
    mov esi, [desk_win_y]
    cmp edx, esi
    jb .drag_step
    add esi, 12
    cmp edx, esi
    ja .drag_step
    mov dword [desk_dragging], 1
    jmp .drag_step

.drag_release:
    mov dword [desk_dragging], 0

.drag_step:
    cmp dword [desk_dragging], 1
    jne .no_click
    mov eax, [mouse_x]
    sub eax, 136
    cmp eax, 2
    jge .drag_x_hi
    mov eax, 2
.drag_x_hi:
    cmp eax, 44
    jle .drag_x_ok
    mov eax, 44
.drag_x_ok:
    mov [desk_win_x], eax

    mov eax, [mouse_y]
    sub eax, 6
    cmp eax, 2
    jge .drag_y_hi
    mov eax, 2
.drag_y_hi:
    cmp eax, 58
    jle .drag_y_ok
    mov eax, 58
.drag_y_ok:
    mov [desk_win_y], eax

.no_click:
    mov edi, VGA_VRAM
    mov ecx, 320*200
    mov al, 1
    rep stosb
    mov edi, VGA_VRAM + (320*188)
    mov ecx, 320*12
    mov al, 8
    rep stosb
    ; Boton inicio LAOS
    mov edi, VGA_VRAM + (320*189) + 4
    mov ecx, 48*9
    mov al, 2
    rep stosb

    ; panel info inferior izq (internet/hora/drivers)
    mov edi, VGA_VRAM + (320*189) + 58
    mov ecx, 82*9
    mov al, 3
    rep stosb

    ; estado de apps en barra (bloques)
    cmp dword [desk_app_explorer], 0
    je .tb_editor
    mov edi, VGA_VRAM + (320*189) + 144
    mov ecx, 12*9
    mov al, 10
    rep stosb
.tb_editor:
    cmp dword [desk_app_editor], 0
    je .tb_taskmgr
    mov edi, VGA_VRAM + (320*189) + 158
    mov ecx, 12*9
    mov al, 11
    rep stosb
.tb_taskmgr:
    cmp dword [desk_app_taskmgr], 0
    je .cmd_window
    mov edi, VGA_VRAM + (320*189) + 172
    mov ecx, 12*9
    mov al, 12
    rep stosb

.cmd_window:
    cmp dword [desk_cmd_min], 1
    je .status_only
    mov eax, [desk_win_y]
    imul eax, 320
    add eax, [desk_win_x]
    add eax, VGA_VRAM
    mov edi, eax
    mov ebx, [desk_win_h]
.wrow:
    push ebx
    mov ecx, [desk_win_w]
    mov al, 7
    rep stosb
    mov eax, [desk_win_w]
    mov edx, 320
    sub edx, eax
    add edi, edx
    pop ebx
    dec ebx
    jnz .wrow
    ; title + botones (_/[])  sin X para CMD
    mov eax, [desk_win_y]
    imul eax, 320
    add eax, [desk_win_x]
    add eax, VGA_VRAM
    mov edi, eax
    mov eax, [desk_win_w]
    imul ecx, eax, 10
    mov al, 4
 .tbar2:
    rep stosb
    mov eax, [desk_win_y]
    add eax, 2
    imul eax, 320
    add eax, [desk_win_x]
    add eax, 244
    add eax, VGA_VRAM
    mov edi, eax
    mov ecx, 14
    mov al, 14
    rep stosb
    add edi, 4
    mov ecx, 12
    mov al, 12
    rep stosb

    ; Ventanas secundarias (cerrables)
    cmp dword [desk_app_explorer], 1
    jne .draw_editor
    mov edi, VGA_VRAM + (320*28) + 38
    mov ecx, 220*70
    mov al, 9
    rep stosb
    mov edi, VGA_VRAM + (320*28) + 38
    mov ecx, 220*8
    mov al, 1
    rep stosb
.draw_editor:
    cmp dword [desk_app_editor], 1
    jne .draw_taskmgr
    mov edi, VGA_VRAM + (320*42) + 56
    mov ecx, 196*62
    mov al, 14
    rep stosb
    mov edi, VGA_VRAM + (320*42) + 56
    mov ecx, 196*8
    mov al, 4
    rep stosb
.draw_taskmgr:
    cmp dword [desk_app_taskmgr], 1
    jne .draw_startmenu
    mov edi, VGA_VRAM + (320*56) + 74
    mov ecx, 172*54
    mov al, 13
    rep stosb
    mov edi, VGA_VRAM + (320*56) + 74
    mov ecx, 172*8
    mov al, 5
    rep stosb

.draw_startmenu:
    ; menu inicio simple
    cmp dword [desk_start_open], 1
    jne .status_only
    mov edi, VGA_VRAM + (320*116) + 4
    mov ecx, 152*70
    mov al, 8
    rep stosb
    mov edi, VGA_VRAM + (320*116) + 4
    mov ecx, 152*10
    mov al, 4
    rep stosb
    mov edi, VGA_VRAM + (320*127) + 4
    mov ecx, 152*10
    mov al, 9
    rep stosb
    mov edi, VGA_VRAM + (320*138) + 4
    mov ecx, 152*10
    mov al, 14
    rep stosb
    mov edi, VGA_VRAM + (320*149) + 4
    mov ecx, 152*10
    mov al, 13
    rep stosb
    mov edi, VGA_VRAM + (320*160) + 4
    mov ecx, 152*10
    mov al, 4
    rep stosb
    mov edi, VGA_VRAM + (320*171) + 4
    mov ecx, 152*10
    mov al, 5
    rep stosb
    mov edi, VGA_VRAM + (320*182) + 4
    mov ecx, 152*5
    mov al, 6
    rep stosb
.status_only:
    nop
    mov eax, [mouse_x]
    mov edx, [mouse_y]
    cmp eax, 1
    jb .poll
    cmp eax, 318
    ja .poll
    cmp edx, 1
    jb .poll
    cmp edx, 198
    ja .poll
    ; Cursor tipo '+'
    imul ebx, edx, 320
    add ebx, eax
    mov byte [VGA_VRAM + ebx], 15
    cmp eax, 2
    jb .poll
    mov byte [VGA_VRAM + ebx - 1], 15
    mov byte [VGA_VRAM + ebx - 2], 15
    cmp eax, 317
    ja .poll
    mov byte [VGA_VRAM + ebx + 1], 15
    mov byte [VGA_VRAM + ebx + 2], 15
    cmp edx, 2
    jb .poll
    mov esi, ebx
    sub esi, 320
    mov byte [VGA_VRAM + esi], 15
    sub esi, 320
    mov byte [VGA_VRAM + esi], 15
    cmp edx, 197
    ja .poll
    mov esi, ebx
    add esi, 320
    mov byte [VGA_VRAM + esi], 15
    add esi, 320
    mov byte [VGA_VRAM + esi], 15
.poll:
    in al, 0x64
    test al, 1
    jz .frame
    in al, 0x60
    cmp al, 0x01
    jne .frame
 .exit_desktop:
    mov esi, vga_regs_3h
    call vga_write_regs
    ret

vga_image_view:
    ; 1. Cambiar a Modo Gráfico 13h (320x200x256) programando puertos VGA
    mov esi, vga_regs_13h
    call vga_write_regs

    ; 2. Limpiar la pantalla (VRAM a 0)
    mov edi, VGA_VRAM
    mov ecx, 320 * 200 / 4
    xor eax, eax
    rep stosd

    ; 3. Analizar y dibujar el archivo BMP
    call draw_bmp

    ; 4. Bucle de bloqueo: Esperar tecla ESC (Scan code 0x01)
.wait_esc:
    in al, 0x60
    cmp al, 0x01        ; 0x01 es el código de presión de ESC
    jne .wait_esc

    ; Esperar a que se suelte la tecla para no inyectar basura al shell
.wait_release:
    in al, 0x60
    test al, 0x80       ; El bit superior indica que se soltó la tecla
    jz .wait_release

    ; 5. Restaurar Modo Texto 3h (80x25) para devolver el control al shell
    mov esi, vga_regs_3h
    call vga_write_regs

    ret

vga_wait_vsync:
    ; Espera a VBlank para reducir parpadeo/tearing en modo 13h.
.wait_not_retrace:
    mov dx, 0x3DA
    in al, dx
    test al, 0x08
    jnz .wait_not_retrace
.wait_retrace:
    in al, dx
    test al, 0x08
    jz .wait_retrace
    ret

; ==================================================================
; RENDERIZADOR DE BMP
; ==================================================================
draw_bmp:
    mov esi, BMP_LOAD_AD

    ; Verificar la firma 'BM' (0x4D42)
    cmp word [esi], 0x4D42
    jne .end

    ; Extraer propiedades del BMP
    mov ebx, [esi + 0x0A] ; Offset donde inician los píxeles
    add ebx, BMP_LOAD_AD  ; Dirección física de los píxeles
    
    mov ecx, [esi + 0x12] ; Ancho
    mov edx, [esi + 0x16] ; Alto

    ; Limitar dimensiones a 320x200 para evitar desbordar la VRAM
    cmp ecx, 320
    jle .width_ok
    mov ecx, 320
.width_ok:
    cmp edx, 200
    jle .height_ok
    mov edx, 200
.height_ok:

    ; Cargar la paleta de colores del BMP (empieza en el offset 54 / 0x36)
    pushad
    mov esi, BMP_LOAD_AD
    add esi, 54
    mov dx, 0x3C8
    mov al, 0
    out dx, al            ; Iniciar DAC en índice 0
    mov dx, 0x3C9
    mov ecx, 256          ; 256 colores a cargar
.load_palette:
    ; Los BMP guardan la paleta en formato B-G-R. 
    ; VGA usa formato R-G-B en rango de 6 bits (0-63), por lo que dividimos entre 4 (shr 2)
    mov bl, [esi + 2]     ; Rojo
    shr bl, 2
    mov al, bl
    out dx, al

    mov bl, [esi + 1]     ; Verde
    shr bl, 2
    mov al, bl
    out dx, al

    mov bl, [esi + 0]     ; Azul
    shr bl, 2
    mov al, bl
    out dx, al

    add esi, 4            ; Avanzar 4 bytes (B, G, R, Reservado)
    dec ecx
    jnz .load_palette
    popad

    ; Dibujar píxeles: Los BMP se almacenan de ABAJO hacia ARRIBA
    mov edi, VGA_VRAM
    ; Calcular inicio de la última fila: (Alto - 1) * 320
    mov eax, edx
    dec eax
    imul eax, 320
    add edi, eax          ; EDI = Dirección del primer píxel de la última fila

    mov esi, ebx          ; ESI = Puntero a la data de píxeles

.draw_row:
    push ecx              ; Guardar Ancho
    push edi              ; Guardar posición de pantalla actual

    rep movsb             ; Copiar fila completa

    pop edi
    pop ecx

    sub edi, 320          ; Subir una fila en la pantalla
    dec edx
    jnz .draw_row         ; Repetir hasta completar el Alto

.end:
    ret

; ==================================================================
; PROGRAMACIÓN DE PUERTOS VGA (MODO PROTEGIDO)
; ==================================================================
vga_write_regs:
    ; ESI debe apuntar al array de registros deseado
    mov dx, 0x3C2       ; Misc Output Register
    lodsb
    out dx, al

    mov ecx, 5          ; Sequencer Registers
    mov ah, 0
.seq_loop:
    mov dx, 0x3C4
    mov al, ah
    out dx, al
    inc dx
    lodsb
    out dx, al
    inc ah
    loop .seq_loop

    mov dx, 0x3D4       ; Desbloquear CRTC
    mov al, 0x11
    out dx, al
    inc dx
    in al, dx
    and al, 0x7F
    out dx, al
    dec dx

    mov ecx, 25         ; CRTC Registers
    mov ah, 0
.crtc_loop:
    mov dx, 0x3D4
    mov al, ah
    out dx, al
    inc dx
    lodsb
    out dx, al
    inc ah
    loop .crtc_loop

    mov ecx, 9          ; Graphics Controller Registers
    mov ah, 0
.gc_loop:
    mov dx, 0x3CE
    mov al, ah
    out dx, al
    inc dx
    lodsb
    out dx, al
    inc ah
    loop .gc_loop

    mov ecx, 21         ; Attribute Controller Registers
    mov ah, 0
.ac_loop:
    mov dx, 0x3DA
    in al, dx           ; Reset flip-flop
    mov dx, 0x3C0
    mov al, ah
    out dx, al
    lodsb
    out dx, al
    inc ah
    loop .ac_loop

    mov dx, 0x3DA       ; Reactivar pantalla en Attribute Controller
    in al, dx
    mov dx, 0x3C0
    mov al, 0x20
    out dx, al
    ret

; ==================================================================
; TABLAS DE REGISTROS MÁGICOS (VALORES ESTÁNDAR IBM VGA)
; ==================================================================

vga_regs_13h:
    db 0x63 ; MISC
    db 0x03, 0x01, 0x0F, 0x00, 0x0E ; SEQ
    db 0x5F, 0x4F, 0x50, 0x82, 0x54, 0x80, 0xBF, 0x1F, 0x00, 0x41, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x9C, 0x8E, 0x8F, 0x28, 0x40, 0x96, 0xB9, 0xA3, 0xFF ; CRTC
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x05, 0x0F, 0xFF ; GC
    db 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x41, 0x00, 0x0F, 0x00, 0x00 ; AC

vga_regs_3h:
    db 0x67 ; MISC
    db 0x03, 0x00, 0x03, 0x00, 0x02 ; SEQ
    db 0x5F, 0x4F, 0x50, 0x82, 0x55, 0x81, 0xBF, 0x1F, 0x00, 0x4F, 0x0D, 0x0E, 0x00, 0x00, 0x00, 0x00, 0x9C, 0x8E, 0x8F, 0x28, 0x0F, 0x96, 0xB9, 0xA3, 0xFF ; CRTC
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x0E, 0x00, 0xFF ; GC
    db 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x14, 0x07, 0x38, 0x39, 0x3A, 0x3B, 0x3C, 0x3D, 0x3E, 0x3F, 0x0C, 0x00, 0x0F, 0x08, 0x00 ; AC

%endif
