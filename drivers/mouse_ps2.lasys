; ==================================================================
; mouse_ps2.lasys - PS/2 mouse básico con IRQ12 y paquetes de 3 bytes
; ==================================================================
%ifndef MOUSE_PS2_LASYS
%define MOUSE_PS2_LASYS

mouse_ready      dd 0
mouse_x          dd 0
mouse_y          dd 0
mouse_buttons    dd 0
mouse_buttons_prev dd 0
mouse_buttons_edge dd 0
mouse_packets    dd 0
mouse_byte_index dd 0
mouse_pkt0       db 0
mouse_pkt1       db 0
mouse_pkt2       db 0
mouse_last_ack   db 0
mouse_wheel      dd 0
mouse_max_x      dd 319
mouse_max_y      dd 199

mouse_wait_input_clear:
    push ecx
    mov ecx, 100000
.w0:
    in al, 0x64
    test al, 2
    jz .ok
    loop .w0
.ok:
    pop ecx
    ret

mouse_wait_output_full:
    push ecx
    mov ecx, 100000
.w1:
    in al, 0x64
    test al, 1
    jnz .ok
    loop .w1
.ok:
    pop ecx
    ret

mouse_read_data_timeout:
    ; OUT: AL=data, EAX=1 ok / 0 timeout
    push ecx
    mov ecx, 100000
.w:
    in al, 0x64
    test al, 1
    jz .next
    in al, 0x60
    mov [mouse_last_ack], al
    mov eax, 1
    pop ecx
    ret
.next:
    loop .w
    xor eax, eax
    pop ecx
    ret

mouse_write_dev:
    ; AL = byte to device
    push eax
    call mouse_wait_input_clear
    mov al, 0xD4
    out 0x64, al
    call mouse_wait_input_clear
    pop eax
    out 0x60, al
    ret

mouse_init:
    ; Enable auxiliary mouse device and IRQ12
    call mouse_wait_input_clear
    mov al, 0xA8
    out 0x64, al

    ; Read/modify/write controller command byte: enable IRQ12 bit (bit1)
    call mouse_wait_input_clear
    mov al, 0x20
    out 0x64, al
    call mouse_wait_output_full
    in al, 0x60
    or al, 0x02
    and al, 0xDF           ; disable translation bit for consistency
    mov bl, al
    call mouse_wait_input_clear
    mov al, 0x60
    out 0x64, al
    call mouse_wait_input_clear
    mov al, bl
    out 0x60, al

    ; Set defaults + enable streaming
    mov al, 0xF6
    call mouse_write_dev
    call mouse_read_data_timeout
    cmp eax, 1
    jne .fail
    cmp al, 0xFA
    jne .fail
    mov al, 0xF4
    call mouse_write_dev
    call mouse_read_data_timeout
    cmp eax, 1
    jne .fail
    cmp al, 0xFA
    jne .fail
    mov dword [mouse_ready], 1
    mov dword [mouse_byte_index], 0
    mov dword [mouse_x], 160
    mov dword [mouse_y], 100
    mov dword [mouse_buttons], 0
    mov dword [mouse_buttons_prev], 0
    mov dword [mouse_buttons_edge], 0
    mov dword [mouse_wheel], 0
    ret
.fail:
    mov dword [mouse_ready], 0
    mov dword [mouse_x], 160
    mov dword [mouse_y], 100
    ret

mouse_irq_handle_byte:
    ; AL = incoming byte from 0x60
    push eax
    push ebx
    mov ebx, [mouse_byte_index]
    cmp ebx, 0
    jne .b1
    test al, 0x08
    jz .done
    mov [mouse_pkt0], al
    mov dword [mouse_byte_index], 1
    jmp .done
.b1:
    cmp ebx, 1
    jne .b2
    mov [mouse_pkt1], al
    mov dword [mouse_byte_index], 2
    jmp .done
.b2:
    mov [mouse_pkt2], al
    mov dword [mouse_byte_index], 0
    inc dword [mouse_packets]

    movzx eax, byte [mouse_pkt0]
    and eax, 0x07
    mov ebx, [mouse_buttons]
    mov [mouse_buttons_prev], ebx
    mov [mouse_buttons], eax
    xor eax, ebx
    and eax, [mouse_buttons]
    mov [mouse_buttons_edge], eax

    ; Bit 6/7 in packet0 indicate overflow: discard movement delta of this packet.
    movzx eax, byte [mouse_pkt0]
    test eax, 0xC0
    jnz .done

    ; Suavizado simple: si el desplazamiento es grande, reducir a la mitad.
    movsx eax, byte [mouse_pkt1]
    cmp eax, 24
    jle .chk_x_neg
    sar eax, 1
.chk_x_neg:
    cmp eax, -24
    jge .x_apply
    sar eax, 1
.x_apply:
    add [mouse_x], eax

    movsx eax, byte [mouse_pkt2]
    cmp eax, 24
    jle .chk_y_neg
    sar eax, 1
.chk_y_neg:
    cmp eax, -24
    jge .y_apply
    sar eax, 1
.y_apply:
    sub [mouse_y], eax

    ; Mantener el cursor dentro de un área segura configurable.
    mov eax, [mouse_x]
    cmp eax, 0
    jge .mx_hi
    xor eax, eax
    mov [mouse_x], eax
.mx_hi:
    mov ebx, [mouse_max_x]
    cmp eax, ebx
    jle .my_low
    mov [mouse_x], ebx
.my_low:
    mov eax, [mouse_y]
    cmp eax, 0
    jge .my_hi
    xor eax, eax
    mov [mouse_y], eax
.my_hi:
    mov ebx, [mouse_max_y]
    cmp eax, ebx
    jle .done
    mov [mouse_y], ebx
.done:
    pop ebx
    pop eax
    ret

%endif
