; ------------------------------------------------------------------
; storage_extra.lasys - Deteccion compacta de unidades A:/C:/D:
; ------------------------------------------------------------------

%ifndef STORAGE_EXTRA_LASYS
%define STORAGE_EXTRA_LASYS

; C: es el backend de FS (RAM seguro y ATA opcional).  A: se marca cuando
; arrancamos desde imagen floppy; D: se prueba como ATAPI primary slave.
cdrom_probe:
    pusha
    mov dword [esp+28], 0
    mov dword [cdrom_present], 0
    mov dx, 0x1F6
    mov al, 0xB0            ; primary slave, ATAPI candidate
    out dx, al
    mov ecx, 4000
.delay:
    loop .delay
    mov dx, 0x1F4
    in al, dx
    mov ah, al
    mov dx, 0x1F5
    in al, dx
    cmp ah, 0x14
    jne .try_old
    cmp al, 0xEB
    je .found
.try_old:
    cmp ah, 0x69
    jne .done
    cmp al, 0x96
    jne .done
.found:
    mov dword [cdrom_present], 1
    mov dword [esp+28], 1
.done:
    popa
    ret

sata_probe:
    ; Sin AHCI PCI todavía: exponer el ATA PIO como disco duro C: si responde.
    cmp dword [ata_present], 1
    jne .no
    mov dword [sata_present], 1
    mov eax, 1
    ret
.no:
    mov dword [sata_present], 0
    xor eax, eax
    ret

floppy_probe_legacy:
    ; La imagen arranca desde floppy; habilitamos A: como unidad real de arranque
    ; y el comando read/write decide si además existe backend ATA para sector I/O.
    mov dword [floppy_present], 1
    mov eax, 1
    ret

cdrom_packet times 12 db 0
cdrom_last_status dd 0

cdrom_wait_drq:
    push ecx
    push edx
    mov dx, 0x1F7
    mov ecx, 0x100000
.wait:
    in al, dx
    test al, 0x80
    jnz .next
    test al, 0x01
    jnz .err
    test al, 0x08
    jnz .ok
.next:
    loop .wait
.err:
    pop edx
    pop ecx
    xor eax, eax
    ret
.ok:
    pop edx
    pop ecx
    mov eax, 1
    ret

cdrom_read_sector:
    ; IN: EAX=LBA, EBX=buffer. Lee un bloque ATAPI de 2048 bytes si D: existe.
    cmp dword [cdrom_present], 1
    jne .fail
    pusha
    mov [cdrom_last_status], eax
    mov dx, 0x1F6
    mov al, 0xB0
    out dx, al
    mov dx, 0x1F1
    xor al, al
    out dx, al
    mov dx, 0x1F4
    mov al, 0x00
    out dx, al
    mov dx, 0x1F5
    mov al, 0x08
    out dx, al
    mov dx, 0x1F7
    mov al, 0xA0
    out dx, al
    call cdrom_wait_drq
    cmp eax, 1
    jne .pop_fail

    mov edi, cdrom_packet
    mov ecx, 12
    xor eax, eax
    rep stosb
    mov eax, [cdrom_last_status]
    mov byte [cdrom_packet+0], 0x28
    mov edx, eax
    shr edx, 24
    mov byte [cdrom_packet+2], dl
    mov edx, eax
    shr edx, 16
    mov byte [cdrom_packet+3], dl
    mov edx, eax
    shr edx, 8
    mov byte [cdrom_packet+4], dl
    mov byte [cdrom_packet+5], al
    mov byte [cdrom_packet+8], 1

    mov esi, cdrom_packet
    mov dx, 0x1F0
    mov ecx, 6
    rep outsw
    call cdrom_wait_drq
    cmp eax, 1
    jne .pop_fail
    mov edi, ebx
    mov dx, 0x1F0
    mov ecx, 1024
    rep insw
    mov dword [cdrom_last_status], 1
    mov dword [esp+28], 1
    popa
    ret
.pop_fail:
    mov dword [cdrom_last_status], 0
    mov dword [esp+28], 0
    popa
    ret
.fail:
    mov dword [cdrom_last_status], 0
    xor eax, eax
    ret

cdrom_capacity:
    ; OUT EAX=1 if READ CAPACITY succeeds, data at FILE_BUFFER.
    cmp dword [cdrom_present], 1
    jne .fail
    pusha
    mov dx, 0x1F6
    mov al, 0xB0
    out dx, al
    mov dx, 0x1F4
    mov al, 8
    out dx, al
    mov dx, 0x1F5
    xor al, al
    out dx, al
    mov dx, 0x1F7
    mov al, 0xA0
    out dx, al
    call cdrom_wait_drq
    cmp eax, 1
    jne .pop_fail
    mov edi, cdrom_packet
    mov ecx, 12
    xor eax, eax
    rep stosb
    mov byte [cdrom_packet], 0x25
    mov esi, cdrom_packet
    mov dx, 0x1F0
    mov ecx, 6
    rep outsw
    call cdrom_wait_drq
    cmp eax, 1
    jne .pop_fail
    mov edi, FILE_BUFFER
    mov dx, 0x1F0
    mov ecx, 4
    rep insw
    mov dword [esp+28], 1
    popa
    ret
.pop_fail:
    mov dword [esp+28], 0
    popa
    ret
.fail:
    xor eax, eax
    ret

%endif
