; ==================================================================
; interrupts.lasys - IDT + PIC + IRQ0 + syscall int80 base
; ==================================================================
%ifndef INTERRUPTS_LASYS
%define INTERRUPTS_LASYS

IDT_BASE equ 0xA800

idt_ptr:
    dw 256*8-1
    dd IDT_BASE
interrupts_ready dd 0
irq_ticks dd 0
scheduler_ticks dd 0
pit_hz dd 100
irq1_keys dd 0
exception_count dd 0
last_exception  dd 0
syscall_count   dd 0
panic_active    dd 0
panic_eip       dd 0
panic_errcode   dd 0
panic_vector    dd 0
panic_magic     dd 0
log_head        dd 0
log_count       dd 0
log_ring        times 128 dd 0
log_event_tmp   dd 0

%macro SET_IDT 2
    mov eax, %1
    mov word [IDT_BASE + (%2*8)], ax
    mov word [IDT_BASE + (%2*8) + 2], 0x08
    mov byte [IDT_BASE + (%2*8) + 4], 0
    mov byte [IDT_BASE + (%2*8) + 5], 0x8E
    shr eax, 16
    mov word [IDT_BASE + (%2*8) + 6], ax
%endmacro

%macro SET_IDT_USER 2
    mov eax, %1
    mov word [IDT_BASE + (%2*8)], ax
    mov word [IDT_BASE + (%2*8) + 2], 0x08
    mov byte [IDT_BASE + (%2*8) + 4], 0
    mov byte [IDT_BASE + (%2*8) + 5], 0xEE
    shr eax, 16
    mov word [IDT_BASE + (%2*8) + 6], ax
%endmacro

interrupts_init:
    cli
    pusha
    mov edi, IDT_BASE
    mov ecx, 256*8/4
    xor eax,eax
    rep stosd

    SET_IDT isr_exc0, 0
    SET_IDT isr_exc1, 1
    SET_IDT isr_exc2, 2
    SET_IDT isr_exc3, 3
    SET_IDT isr_exc4, 4
    SET_IDT isr_exc5, 5
    SET_IDT isr_exc6, 6
    SET_IDT isr_exc7, 7
    SET_IDT isr_exc8, 8
    SET_IDT isr_exc9, 9
    SET_IDT isr_exc10, 10
    SET_IDT isr_exc11, 11
    SET_IDT isr_exc12, 12
    SET_IDT isr_exc13, 13
    SET_IDT isr_exc14, 14
    SET_IDT isr_exc15, 15
    SET_IDT isr_exc16, 16
    SET_IDT isr_exc17, 17
    SET_IDT isr_exc18, 18
    SET_IDT isr_exc19, 19
    SET_IDT isr_irq0, 32
    SET_IDT isr_irq1, 33
    SET_IDT isr_irq12, 44
    SET_IDT_USER isr_syscall80, 128

    ; PIC remap 0x20/0x28
    mov al,0x11
    out 0x20,al
    out 0xA0,al
    mov al,0x20
    out 0x21,al
    mov al,0x28
    out 0xA1,al
    mov al,0x04
    out 0x21,al
    mov al,0x02
    out 0xA1,al
    mov al,0x01
    out 0x21,al
    out 0xA1,al

    ; Unmask IRQ0 + IRQ1 + IRQ2(cascade para slave/IRQ12)
    mov al,0xF8
    out 0x21,al
    ; Unmask IRQ12 (slave IRQ4)
    mov al,0xEF
    out 0xA1,al

    ; PIT default @100Hz
    mov eax, 100
    call pit_set_hz
    call mouse_init

    lidt [idt_ptr]
    mov dword [interrupts_ready],1
    popa
    ret

pit_set_hz:
    ; IN: EAX = requested hz (10..1000). OUT: EAX=1 ok / 0 invalid
    cmp eax, 10
    jb .bad
    cmp eax, 1000
    ja .bad
    mov [pit_hz], eax
    push ebx
    push edx
    mov ebx, eax
    mov eax, 1193182
    xor edx, edx
    div ebx
    mov bx, ax
    mov al, 0x36
    out 0x43, al
    mov al, bl
    out 0x40, al
    mov al, bh
    out 0x40, al
    pop edx
    pop ebx
    mov eax, 1
    ret
.bad:
    xor eax, eax
    ret

interrupts_enable:
    sti
    ret

interrupt_log_push:
    ; EAX = 32-bit event
    pusha
    mov ebx, [log_head]
    and ebx, 127
    mov [log_ring + ebx*4], eax
    inc dword [log_head]
    cmp dword [log_count], 128
    jae .done
    inc dword [log_count]
.done:
    popa
    ret

%macro EXC_STUB_NOERR 2
%1:
    push dword 0
    push dword %2
    jmp isr_exception_common
%endmacro

%macro EXC_STUB_ERR 2
%1:
    push dword %2
    jmp isr_exception_common
%endmacro

isr_exception_common:
    pusha
    mov eax, [esp+36]
    mov [last_exception], eax
    inc dword [exception_count]
    mov eax, [esp+32]
    mov [panic_errcode], eax
    mov eax, [esp+44]
    mov [panic_eip], eax
    mov eax, [esp+36]
    mov [panic_vector], eax
    mov dword [panic_magic], 0x50414E43 ; "PANC"
    mov dword [panic_active], 1
    mov eax, [panic_vector]
    shl eax, 24
    or eax, [panic_errcode]
    call interrupt_log_push
    call api_clear_screen
    mov esi, panic_msg_1
    call api_print_string
    mov eax, [panic_vector]
    call print_hex32
    mov esi, panic_msg_2
    call api_print_string
    mov eax, [panic_errcode]
    call print_hex32
    mov esi, panic_msg_3
    call api_print_string
    mov eax, [panic_eip]
    call print_hex32
    cli
.halt:
    hlt
    jmp .halt

EXC_STUB_NOERR isr_exc0, 0
EXC_STUB_NOERR isr_exc1, 1
EXC_STUB_NOERR isr_exc2, 2
EXC_STUB_NOERR isr_exc3, 3
EXC_STUB_NOERR isr_exc4, 4
EXC_STUB_NOERR isr_exc5, 5
EXC_STUB_NOERR isr_exc6, 6
EXC_STUB_NOERR isr_exc7, 7
EXC_STUB_ERR   isr_exc8, 8
EXC_STUB_NOERR isr_exc9, 9
EXC_STUB_ERR   isr_exc10, 10
EXC_STUB_ERR   isr_exc11, 11
EXC_STUB_ERR   isr_exc12, 12
EXC_STUB_ERR   isr_exc13, 13
EXC_STUB_ERR   isr_exc14, 14
EXC_STUB_NOERR isr_exc15, 15
EXC_STUB_NOERR isr_exc16, 16
EXC_STUB_ERR   isr_exc17, 17
EXC_STUB_NOERR isr_exc18, 18
EXC_STUB_NOERR isr_exc19, 19

isr_irq0:
    pusha
    inc dword [irq_ticks]
    inc dword [scheduler_ticks]
    mov eax, 0x10000020
    call interrupt_log_push
    call scheduler_on_tick
    ; EOI
    mov al,0x20
    out 0x20,al
    popa
    iretd

isr_irq1:
    pusha
    ; Captura scancode por IRQ y encola para lectura estable en shell.
    in al,0x60
    call kbd_irq_push_scancode
    inc dword [irq1_keys]
    mov eax, 0x10000021
    call interrupt_log_push
    mov al,0x20
    out 0x20,al
    popa
    iretd

isr_irq12:
    pusha
    in al,0x64
    test al, 1
    jz .eoi
    ; En IRQ12 confiamos en la fuente de interrupción (mouse). Algunos
    ; emuladores no mantienen AUX(bit5) estable en este punto.
    in al,0x60
    call mouse_irq_handle_byte
    mov eax, 0x1000002C
    call interrupt_log_push
.eoi:
    mov al,0x20
    out 0xA0,al
    out 0x20,al
    popa
    iretd

isr_syscall80:
    pusha
    mov ebp, eax
    inc dword [syscall_count]
    mov eax, 0x20000080
    call interrupt_log_push
    mov eax, ebp
    ; EAX=syscall
    cmp eax,1
    je .sys_puts
    cmp eax,2
    je .sys_ticks
    cmp eax,3
    je .sys_alloc
    cmp eax,4
    je .sys_yield
    cmp eax,5
    je .sys_getpid
    cmp eax,6
    je .sys_exit
    cmp eax,7
    je .sys_taskstat
    cmp eax,10
    je .sys_draw_pixel
    cmp eax,11
    je .sys_draw_rect
    cmp eax,12
    je .sys_get_key
    jmp .done
.sys_puts:
    ; EBX = ptr null-term string
    mov esi, ebx
    call api_print_string
    xor eax,eax
    jmp .done
.sys_ticks:
    mov eax, [irq_ticks]
    mov [esp+28], eax
    jmp .done
.sys_alloc:
    mov ecx, ebx
    call kmalloc
    mov [esp+28], eax
    jmp .done
.sys_yield:
    call scheduler_yield
    xor eax,eax
    mov [esp+28], eax
    jmp .done
.sys_getpid:
    mov eax, [sched_current]
    mov [esp+28], eax
    jmp .done
.sys_exit:
    mov eax, [sched_current]
    mov edi, sched_tcbs
    imul ecx, eax, TCB_SIZE
    add edi, ecx
    mov dword [edi+36], TASK_ZOMBIE
    xor eax,eax
    mov [esp+28], eax
    jmp .done
.sys_taskstat:
    mov eax, ebx
    cmp eax, [sched_task_count]
    jae .sys_taskstat_fail
    mov edi, sched_tcbs
    imul ecx, eax, TCB_SIZE
    add edi, ecx
    mov eax, [edi+36]
    mov [esp+28], eax
    jmp .done
.sys_taskstat_fail:
    mov eax, 0xFFFFFFFF
    mov [esp+28], eax
    jmp .done
.sys_draw_pixel:
    ; ebx=x ecx=y edx=color
    mov eax, ebx
    mov ebx, ecx
    mov esi, edx
    call graphics_draw_pixel
    xor eax, eax
    mov [esp+28], eax
    jmp .done
.sys_draw_rect:
    ; ebx=x ecx=y edx=w esi=h edi=color
    mov eax, ebx
    mov ebx, ecx
    mov ecx, edx
    mov edx, esi
    mov esi, edi
    call graphics_fill_rect
    xor eax, eax
    mov [esp+28], eax
    jmp .done
.sys_get_key:
    call kbd_read_char
    movzx eax, al
    mov [esp+28], eax
.done:
    popa
    iretd

panic_msg_1 db 0x0A,"*** KERNEL PANIC *** Excepcion: ",0
panic_msg_2 db 0x0A,"Codigo error: ",0
panic_msg_3 db 0x0A,"EIP: ",0

%endif
