; ------------------------------------------------------------------
; fs.lasys - Minimal Flat Filesystem REAL
; Directory LBA: 30. Máx 16 archivos
; Entry: 16 bytes nombre, 4 bytes LBA, 4 bytes tamaño, 1 byte flags, 1 byte parent (26 bytes)
; ------------------------------------------------------------------

%ifndef FS_LASYS
%define FS_LASYS

DIR_LBA     equ 30
DATA_LBA    equ 31
DIR_BUFFER  equ 0x5000  ; Directorio en memoria
FILE_BUFFER equ 0x6000  ; Buffer I/O
APP_POINTER equ 0x7000  ; Puntero a app cargada
RAMFS_DATA  equ 0xD000  ; 16 sectores RAM para fallback sin ATA
DIR_ENTRY_SIZE equ 26
FS_MODE_NONE equ 0
FS_MODE_ATA  equ 1
FS_MODE_RAM  equ 2

; FLAGS
FLAG_FILE   equ 1
FLAG_DIR    equ 2
ROOT_PARENT equ 0xFF

fs_init:
    ; The boot image is a floppy image, not an ATA disk.  Always start with
    ; the RAM filesystem so the shell has reliable file commands on every
    ; emulator/machine.  ATA remains an optional backend for future mounting,
    ; but it is never required for boot or the terminal.
    call fs_init_ram
    ret

fs_init_ata:
    cmp dword [ata_present], 1
    jne fs_init
    mov dword [fs_storage_mode], FS_MODE_ATA
    mov eax, DIR_LBA
    mov ebx, DIR_BUFFER
    call floppy_read_sector
    ret

fs_storage_mode dd FS_MODE_NONE
fs_journal_seq dd 0
fs_create_flag db 0
fs_write_name_ptr dd 0
fs_write_buf_ptr dd 0

fs_init_ram:
    mov dword [fs_storage_mode], FS_MODE_RAM
    ; Clear directory sector.
    mov edi, DIR_BUFFER
    mov ecx, 512/4
    xor eax, eax
    rep stosd

    ; Entry 0: test.txt -> RAM sector DATA_LBA.
    mov esi, ramfs_test_name
    mov edi, DIR_BUFFER
    mov ecx, 16
.copy_name:
    lodsb
    stosb
    cmp al, 0
    je .pad_name
    loop .copy_name
    jmp .name_done
.pad_name:
    dec ecx
    jz .name_done
.pad_loop:
    mov byte [edi], 0
    inc edi
    loop .pad_loop
.name_done:
    mov dword [DIR_BUFFER+16], DATA_LBA
    mov dword [DIR_BUFFER+20], ramfs_test_end - ramfs_test_data
    mov byte [DIR_BUFFER+24], FLAG_FILE
    mov byte [DIR_BUFFER+25], 0

    ; Clear RAM file area and copy demo file content.
    mov edi, RAMFS_DATA
    mov ecx, (16*512)/4
    xor eax, eax
    rep stosd
    mov esi, ramfs_test_data
    mov edi, RAMFS_DATA
    mov ecx, ramfs_test_end - ramfs_test_data
    rep movsb
    ret

ramfs_test_name db "test.txt",0
ramfs_test_data db "Hello from RAM FS!",0x0A,0
ramfs_test_end:

fs_save_dir:
    inc dword [fs_journal_seq]
    cmp dword [fs_storage_mode], FS_MODE_ATA
    jne .done
    mov eax, DIR_LBA
    mov ebx, DIR_BUFFER
    call floppy_write_sector
.done:
    ret

fs_create_file:
    mov [fs_create_flag], al
    mov edi, DIR_BUFFER
    mov ecx, 16
.find_empty:
    cmp byte [edi],0
    je .found
    add edi, DIR_ENTRY_SIZE
    loop .find_empty
    xor eax, eax
    ret
.found:
    push edi
    mov ecx,16
.copy_name:
    lodsb
    cmp al,0
    je .fill_zero
    stosb
    loop .copy_name
    jmp .name_done
.fill_zero:
    mov al,0
.fill_loop:
    stosb
    loop .fill_loop
    pop edi
    ; asignar sector
    mov eax, edi
    sub eax, DIR_BUFFER
    mov ebx, DIR_ENTRY_SIZE
    xor edx,edx
    div ebx
    add eax, DATA_LBA
    mov [edi+16], eax   ; LBA
    mov dword [edi+20], 0 ; tamaño
    mov al, [fs_create_flag]
    mov byte [edi+24], al ; flag
    mov byte [edi+25], 0 ; parent(root)
    call fs_save_dir
    mov eax, 1
    ret
.name_done:
    pop edi
    mov eax, edi
    sub eax, DIR_BUFFER
    mov ebx, DIR_ENTRY_SIZE
    xor edx,edx
    div ebx
    add eax, DATA_LBA
    mov [edi+16], eax
    mov dword [edi+20], 0
    mov al, [fs_create_flag]
    mov byte [edi+24], al
    mov byte [edi+25], 0
    call fs_save_dir
    mov eax, 1
    ret
.name_done:
    pop edi
    mov eax, edi
    sub eax, DIR_BUFFER
    mov ebx, DIR_ENTRY_SIZE
    xor edx,edx
    div ebx
    add eax, DATA_LBA
    mov [edi+16], eax
    mov dword [edi+20], 0
    mov al, [fs_create_flag]
    mov byte [edi+24], al
    mov byte [edi+25], 0
    call fs_save_dir
    ret

fs_read_file:
    mov edi, DIR_BUFFER
    mov ecx,16
    xor eax,eax
.find_file:
    cmp byte [edi],0
    je .next
    push edi
    push esi
    mov edx,16
.compare:
    mov al, [esi]
    cmp al, [edi]
    jne .not_match
    cmp al, 0
    je .match_done
    inc esi
    inc edi
    dec edx
    jnz .compare
.match_done:
    pop esi
    pop edi
    ; encontrado
    mov eax,[edi+16]      ; LBA
    mov ecx,[edi+20]      ; tamaño exacto en bytes
    cmp dword [fs_storage_mode], FS_MODE_ATA
    je .read_ata
    push ecx
    push esi
    push edi
    sub eax, DATA_LBA
    shl eax, 9
    mov esi, RAMFS_DATA
    add esi, eax
    mov edi, APP_POINTER
    mov ecx, 512
    rep movsb
    pop edi
    pop esi
    pop ecx
    ret
.read_ata:
    push ecx
    mov ebx, APP_POINTER
    call floppy_read_sector
    pop ecx
    ret
.not_match:
    pop esi
    pop edi
.next:
    add edi, DIR_ENTRY_SIZE
    dec ecx
    jnz .find_file
    xor eax,eax
    ret

fs_write_file:
    mov ebp, ecx            ; preservar tamaño a guardar
    mov [fs_write_name_ptr], esi
    mov [fs_write_buf_ptr], ebx
    mov edi, DIR_BUFFER
    mov edx,16
.find_file_write:
    cmp byte [edi],0
    je .next
    push edi
    push esi
    mov ecx,16
.compare_write:
    mov al,[esi]
    cmp al,[edi]
    jne .not_match
    cmp al,0
    je .match_done
    inc esi
    inc edi
    dec ecx
    jnz .compare_write
.match_done:
    pop esi
    pop edi
    ; encontrado
    mov eax,[edi+16] ; LBA
    cmp dword [fs_storage_mode], FS_MODE_ATA
    je .write_ata
    push esi
    push edi
    push ecx
    mov esi, ebx
    sub eax, DATA_LBA
    shl eax, 9
    mov edi, RAMFS_DATA
    add edi, eax
    mov ecx, 512
    rep movsb
    pop ecx
    pop edi
    pop esi
    jmp .write_done
.write_ata:
    call floppy_write_sector
.write_done:
    mov [edi+20], ebp ; Guarda el tamaño
    call fs_save_dir
    ret
.not_match:
    pop esi
    pop edi
.next:
    add edi, DIR_ENTRY_SIZE
    dec edx
    jnz .find_file_write
    ; Si el archivo no existe, crearlo y reintentar una vez.
    mov esi, [fs_write_name_ptr]
    mov al, FLAG_FILE
    call fs_create_file
    cmp eax, 0
    je .fail_create
    mov esi, [fs_write_name_ptr]
    mov ebx, [fs_write_buf_ptr]
    mov ecx, ebp
    call fs_write_file
.fail_create:
    ret

fs_change_dir:
    mov edi, DIR_BUFFER
    mov ecx,16
.find_dir:
    cmp byte [edi],0
    je .not_found
    push edi
    push esi
    mov edx,16
.compare_dir:
    mov al,[esi]
    cmp al,[edi]
    jne .skip_compare
    cmp al,0
    je .dir_match
    inc esi
    inc edi
    dec edx
    jnz .compare_dir
.dir_match:
    pop esi
    pop edi
    ; validar flag
    cmp byte [edi+24], FLAG_DIR
    jne .not_found
    ; actualizar current_path
    mov esi, [arg_ptr]      
    cmp byte [esi],'.'
    jne .append_dir
    cmp byte [esi+1],'.'
    jne .append_dir
    mov edi, current_path
.back_loop:
    dec edi
    cmp byte [edi],'/'
    je .done_back
    cmp edi, current_path
    je .done_back
    jmp .back_loop
.done_back:
    mov byte [edi+1],0
    ret
.append_dir:
    mov edi, current_path
.find_end:
    cmp byte [edi],0
    je .copy_dir
    inc edi
    jmp .find_end
.copy_dir:
    mov esi, [arg_ptr]
.copy_loop:
    lodsb
    stosb
    cmp al,0
    je .add_slash
    jmp .copy_loop
.add_slash:
    mov al,'/'
    stosb
    mov byte [edi],0
    ret
.skip_compare:
    add edi,1
    dec edx
    jnz .compare_dir
    pop esi
    pop edi
    add edi, DIR_ENTRY_SIZE
    dec ecx
    jnz .find_dir
.not_found:
    ret


fs_delete_entry:
    ; ESI = nombre
    mov edi, DIR_BUFFER
    mov ecx,16
.find_del:
    cmp byte [edi],0
    je .next
    push edi
    push esi
    mov edx,16
.compare:
    mov al,[esi]
    cmp al,[edi]
    jne .no
    cmp al,0
    je .match
    inc esi
    inc edi
    dec edx
    jnz .compare
.match:
    pop esi
    pop edi
    mov ecx,26
    xor eax,eax
    rep stosb
    call fs_save_dir
    mov eax,1
    ret
.no:
    pop esi
    pop edi
.next:
    add edi, DIR_ENTRY_SIZE
    dec ecx
    jnz .find_del
    xor eax,eax
    ret

%endif