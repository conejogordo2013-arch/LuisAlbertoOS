; ------------------------------------------------------------------
; fs.lasys - Flat filesystem with fixed block chains
; Directory LBA: 96. Block table LBA: 97. Data starts at LBA 98.
; Entry: 16 bytes name, 4 bytes first LBA, 4 bytes real size, 1 byte flags, 1 byte parent
; ------------------------------------------------------------------

%ifndef FS_LASYS
%define FS_LASYS

DIR_LBA     equ 96
BLOCK_LBA   equ 97
DATA_LBA    equ 98
DIR_BUFFER  equ 0x5000
FILE_BUFFER equ 0x68000
APP_POINTER equ 0x70000
RAMFS_DATA  equ 0x20000
DIR_ENTRY_SIZE equ 26
FS_MAX_ENTRIES equ 16
FS_BLOCKS_PER_FILE equ 16
FS_TOTAL_BLOCKS equ FS_MAX_ENTRIES*FS_BLOCKS_PER_FILE
FS_MAX_FILE_BYTES equ FS_BLOCKS_PER_FILE*512
FS_MODE_NONE equ 0
FS_MODE_ATA  equ 1
FS_MODE_RAM  equ 2

; FLAGS
FLAG_FILE   equ 1
FLAG_DIR    equ 2
ROOT_PARENT equ 0xFF

fs_init:
    call fs_init_ram
    ret

fs_init_ata:
    cmp dword [ata_present], 1
    jne fs_init
    mov dword [fs_storage_mode], FS_MODE_ATA
    mov eax, DIR_LBA
    mov ebx, DIR_BUFFER
    call floppy_read_sector
    mov eax, BLOCK_LBA
    mov ebx, fs_block_table
    call floppy_read_sector
    ret

fs_storage_mode dd FS_MODE_NONE
fs_journal_seq dd 0
fs_create_flag db 0
fs_write_name_ptr dd 0
fs_write_buf_ptr dd 0
fs_rename_new_ptr dd 0
fs_block_table times 512 db 0
fs_last_entry_index dd 0

fs_init_ram:
    mov dword [fs_storage_mode], FS_MODE_RAM
    mov edi, DIR_BUFFER
    mov ecx, 512/4
    xor eax, eax
    rep stosd
    mov edi, fs_block_table
    mov ecx, 512/4
    xor eax, eax
    rep stosd

    ; Entry 0: test.txt -> 16-block chain starting at DATA_LBA.
    mov esi, ramfs_test_name
    mov edi, DIR_BUFFER
    mov ecx, 16
.copy_name:
    lodsb
    stosb
    cmp al, 0
    je .pad_name
    loop .copy_name
    jmp .name_done
.pad_name:
    dec ecx
    jz .name_done
.pad_loop:
    mov byte [edi], 0
    inc edi
    loop .pad_loop
.name_done:
    mov dword [DIR_BUFFER+16], DATA_LBA
    mov dword [DIR_BUFFER+20], ramfs_test_end - ramfs_test_data
    mov byte [DIR_BUFFER+24], FLAG_FILE
    mov byte [DIR_BUFFER+25], 0
    xor eax, eax
    call fs_mark_entry_chain

    mov edi, RAMFS_DATA
    mov ecx, (FS_TOTAL_BLOCKS*512)/4
    xor eax, eax
    rep stosd
    mov esi, ramfs_test_data
    mov edi, RAMFS_DATA
    mov ecx, ramfs_test_end - ramfs_test_data
    rep movsb
    ret

ramfs_test_name db "test.txt",0
ramfs_test_data db "Hello from RAM FS multi-sector!",0x0A,0
ramfs_test_end:

fs_save_dir:
    inc dword [fs_journal_seq]
    cmp dword [fs_storage_mode], FS_MODE_ATA
    jne .done
    mov eax, DIR_LBA
    mov ebx, DIR_BUFFER
    call floppy_write_sector
    mov eax, BLOCK_LBA
    mov ebx, fs_block_table
    call floppy_write_sector
.done:
    ret

; EAX = entry index. Marks its 16 reserved data blocks as a block-table chain.
fs_mark_entry_chain:
    pusha
    mov ebx, eax
    shl ebx, 4                       ; start block = index * 16
    mov edi, fs_block_table
    add edi, ebx
    mov ecx, FS_BLOCKS_PER_FILE - 1
    mov al, bl
.chain:
    inc al
    inc al                           ; stored next block is index+1, zero means free
    stosb
    dec al
    loop .chain
    mov al, 0xFF
    stosb
    popa
    ret

; EDI = directory entry. Clears all sectors in the entry's reserved extent.
fs_clear_entry_data:
    cmp byte [edi+24], FLAG_FILE
    jne .done
    pusha
    mov eax, [edi+16]
    sub eax, DATA_LBA
    cmp dword [fs_storage_mode], FS_MODE_ATA
    je .clear_ata
    shl eax, 9
    mov edi, RAMFS_DATA
    add edi, eax
    mov ecx, FS_MAX_FILE_BYTES/4
    xor eax, eax
    rep stosd
    jmp .out
.clear_ata:
    mov edi, FILE_BUFFER
    mov ecx, 512/4
    xor eax, eax
    rep stosd
    mov edx, FS_BLOCKS_PER_FILE
    mov esi, [esp]                   ; original EDI saved by pusha
    mov eax, [esi+16]
.ata_loop:
    mov ebx, FILE_BUFFER
    call floppy_write_sector
    inc eax
    dec edx
    jnz .ata_loop
.out:
    popa
.done:
    ret

fs_create_file:
    mov [fs_create_flag], al
    mov edi, DIR_BUFFER
    mov ecx, FS_MAX_ENTRIES
.find_empty:
    cmp byte [edi],0
    je .found
    add edi, DIR_ENTRY_SIZE
    loop .find_empty
    xor eax, eax
    ret
.found:
    push edi
    mov ecx,16
.copy_name:
    lodsb
    cmp al,0
    je .fill_zero
    stosb
    loop .copy_name
    jmp .name_done
.fill_zero:
    mov al,0
.fill_loop:
    stosb
    loop .fill_loop
.name_done:
    pop edi
    mov eax, edi
    sub eax, DIR_BUFFER
    mov ebx, DIR_ENTRY_SIZE
    xor edx,edx
    div ebx
    mov [fs_last_entry_index], eax
    push eax
    shl eax, 4
    add eax, DATA_LBA
    mov [edi+16], eax
    mov dword [edi+20], 0
    mov al, [fs_create_flag]
    mov byte [edi+24], al
    mov byte [edi+25], 0
    pop eax
    call fs_mark_entry_chain
    call fs_clear_entry_data
    call fs_save_dir
    mov eax, 1
    ret

; ESI = name. OUT: EAX=1, EDI=entry, ECX=size or EAX=0.
fs_find_entry:
    mov edi, DIR_BUFFER
    mov ecx, FS_MAX_ENTRIES
.find_file:
    cmp byte [edi],0
    je .next
    push edi
    push esi
    mov edx,16
.compare:
    mov al, [esi]
    cmp al, [edi]
    jne .not_match
    cmp al, 0
    je .match_done
    inc esi
    inc edi
    dec edx
    jnz .compare
.match_done:
    pop esi
    pop edi
    mov ecx,[edi+20]
    mov eax,1
    ret
.not_match:
    pop esi
    pop edi
.next:
    add edi, DIR_ENTRY_SIZE
    dec ecx
    jnz .find_file
    xor eax,eax
    ret

fs_read_file:
    call fs_find_entry
    cmp eax, 0
    jne .found
    ret
.found:
    mov eax,[edi+16]
    mov ecx,[edi+20]
    push ecx
    cmp dword [fs_storage_mode], FS_MODE_ATA
    je .read_ata
    mov esi, RAMFS_DATA
    mov ebx, eax
    sub ebx, DATA_LBA
    shl ebx, 9
    add esi, ebx
    mov edi, APP_POINTER
    mov ecx, [esp]
    cmp ecx, FS_MAX_FILE_BYTES
    jbe .copy_ram
    mov ecx, FS_MAX_FILE_BYTES
.copy_ram:
    rep movsb
    mov byte [edi], 0
    pop ecx
    mov eax,1
    ret
.read_ata:
    mov edi, APP_POINTER
    mov edx, [esp]
    add edx, 511
    shr edx, 9
    cmp edx, 0
    jne .ata_count_ok
    mov edx, 1
.ata_count_ok:
    cmp edx, FS_BLOCKS_PER_FILE
    jbe .ata_loop
    mov edx, FS_BLOCKS_PER_FILE
.ata_loop:
    push eax
    push edx
    mov ebx, edi
    call floppy_read_sector
    pop edx
    pop eax
    add edi, 512
    inc eax
    dec edx
    jnz .ata_loop
    pop ecx
    mov eax,1
    ret

fs_write_file:
    cmp ecx, FS_MAX_FILE_BYTES
    jbe .size_ok
    mov ecx, FS_MAX_FILE_BYTES
.size_ok:
    mov ebp, ecx
    mov [fs_write_name_ptr], esi
    mov [fs_write_buf_ptr], ebx
    call fs_find_entry
    cmp eax, 0
    jne .found
    mov esi, [fs_write_name_ptr]
    mov al, FLAG_FILE
    call fs_create_file
    cmp eax, 0
    je .fail_create
    mov esi, [fs_write_name_ptr]
    call fs_find_entry
    cmp eax, 0
    je .fail_create
.found:
    cmp byte [edi+24], FLAG_DIR
    je .fail_create
    mov eax,[edi+16]
    cmp dword [fs_storage_mode], FS_MODE_ATA
    je .write_ata
    push edi
    push esi
    mov esi, [fs_write_buf_ptr]
    mov edx, eax
    sub edx, DATA_LBA
    shl edx, 9
    mov edi, RAMFS_DATA
    add edi, edx
    mov ecx, FS_MAX_FILE_BYTES
    xor eax, eax
    rep stosb
    sub edi, FS_MAX_FILE_BYTES
    mov ecx, ebp
    rep movsb
    pop esi
    pop edi
    jmp .write_done
.write_ata:
    push edi
    mov esi, [fs_write_buf_ptr]
    mov edx, ebp
    add edx, 511
    shr edx, 9
    cmp edx, 0
    jne .ata_count_ok
    mov edx, 1
.ata_count_ok:
    cmp edx, FS_BLOCKS_PER_FILE
    jbe .ata_loop
    mov edx, FS_BLOCKS_PER_FILE
.ata_loop:
    push eax
    push edx
    mov ebx, esi
    call floppy_write_sector
    pop edx
    pop eax
    add esi, 512
    inc eax
    dec edx
    jnz .ata_loop
    pop edi
.write_done:
    mov [edi+20], ebp
    call fs_save_dir
    mov eax, 1
    ret
.fail_create:
    xor eax, eax
    ret

; ESI = old name, EDI = new name
fs_rename_entry:
    mov [fs_rename_new_ptr], edi
    call fs_find_entry
    cmp eax, 0
    je .fail
    mov esi, [fs_rename_new_ptr]
    mov ecx,16
.copy_name:
    lodsb
    cmp al,0
    je .fill_zero
    stosb
    loop .copy_name
    jmp .done
.fill_zero:
    mov al,0
.fill_loop:
    stosb
    loop .fill_loop
.done:
    call fs_save_dir
    mov eax,1
    ret
.fail:
    xor eax,eax
    ret

fs_change_dir:
    call fs_find_entry
    cmp eax,0
    je .not_found
    cmp byte [edi+24], FLAG_DIR
    jne .not_found
    mov esi, [arg_ptr]
    cmp byte [esi],'.'
    jne .append_dir
    cmp byte [esi+1],'.'
    jne .append_dir
    mov edi, current_path
.back_loop:
    dec edi
    cmp byte [edi],'/'
    je .done_back
    cmp edi, current_path
    je .done_back
    jmp .back_loop
.done_back:
    mov byte [edi+1],0
    ret
.append_dir:
    mov edi, current_path
.find_end:
    cmp byte [edi],0
    je .copy_dir
    inc edi
    jmp .find_end
.copy_dir:
    mov esi, [arg_ptr]
.copy_loop:
    lodsb
    stosb
    cmp al,0
    je .add_slash
    jmp .copy_loop
.add_slash:
    mov al,'/'
    stosb
    mov byte [edi],0
.not_found:
    ret

fs_delete_entry:
    call fs_find_entry
    cmp eax,0
    je .fail
    mov ecx, DIR_ENTRY_SIZE
    xor eax,eax
    rep stosb
    call fs_save_dir
    mov eax,1
    ret
.fail:
    xor eax,eax
    ret

fs_format:
    call fs_init_ram
    call fs_save_dir
    ret

%endif
