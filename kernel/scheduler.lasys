; ==================================================================
; scheduler.lasys - Round-robin base con TCB y cambio de contexto básico
; ==================================================================
%ifndef SCHEDULER_LASYS
%define SCHEDULER_LASYS

MAX_TASKS equ 8
TCB_SIZE  equ 40 ; esp,eip,ebp,ebx,esi,edi,eax,ecx,edx,state
TASK_READY equ 1
TASK_RUNNING equ 2
TASK_BLOCKED equ 3
TASK_ZOMBIE  equ 4

sched_task_count dd 0
sched_current    dd 0
sched_enabled    dd 0
sched_preemptive dd 0 ; stable cooperative mode by default
sched_quantum    dd 10
sched_switch_count dd 0
sched_last_switch_from dd 0
sched_last_switch_to   dd 0

sched_tcbs:
    times MAX_TASKS*TCB_SIZE db 0

scheduler_init:
    mov dword [sched_task_count], 1
    mov dword [sched_current], 0
    mov dword [sched_enabled], 1
    mov dword [sched_preemptive], 0
    mov dword [sched_last_switch_from], 0
    mov dword [sched_last_switch_to], 0
    ret

scheduler_register_kernel_main:
    ; task0 = shell/kernel thread current context base
    mov edi, sched_tcbs
    mov [edi+0], esp
    mov dword [edi+36], TASK_RUNNING
    ret

scheduler_on_tick:
    ; Keep timer accounting enabled, but do not preemptively swap stacks yet.
    ; The demo scheduler can register/block/wake tasks, while real stack
    ; switching remains optional until complete interrupt return frames exist.
    cmp dword [sched_enabled], 1
    jne .done
    cmp dword [sched_preemptive], 1
    jne .done
    mov eax, [irq_ticks]
    xor edx, edx
    mov ecx, [sched_quantum]
    test ecx, ecx
    jz .done
    div ecx
    cmp edx, 0
    jne .done
    call scheduler_yield
.done:
    ret

scheduler_yield:
    ; Cooperative accounting only unless preemption is explicitly enabled.
    ; This avoids switching to an unprepared demo stack from IRQ0.
    cmp dword [sched_preemptive], 1
    jne .ret
    mov eax, [sched_current]
    mov edi, sched_tcbs
    imul ecx, eax, TCB_SIZE
    add edi, ecx
    mov [edi+0], esp
    ; RR mínimo entre tareas READY/RUNNING, base para expansión
    mov eax, [sched_task_count]
    cmp eax, 1
    jle .ret
    mov ebx, [sched_current]
.next:
    inc ebx
    cmp ebx, eax
    jl .chk
    xor ebx, ebx
.chk:
    mov edi, sched_tcbs
    imul ecx, ebx, TCB_SIZE
    add edi, ecx
    cmp dword [edi+36], TASK_READY
    je .switch
    cmp dword [edi+36], TASK_RUNNING
    je .switch
    cmp ebx, [sched_current]
    jne .next
    jmp .ret
.switch:
    mov eax, [sched_current]
    mov [sched_last_switch_from], eax
    mov [sched_last_switch_to], ebx
    mov [sched_current], ebx
    mov edi, sched_tcbs
    imul ecx, ebx, TCB_SIZE
    add edi, ecx
    mov esp, [edi+0]
    inc dword [sched_switch_count]
.ret:
    ret



scheduler_add_kthread:
    ; IN: EAX = entry eip, EBX = stack_top
    mov ecx, [sched_task_count]
    cmp ecx, MAX_TASKS
    jae .fail
    mov edi, sched_tcbs
    imul edx, ecx, TCB_SIZE
    add edi, edx
    mov [edi+0], ebx       ; esp
    mov [edi+4], eax       ; eip
    mov dword [edi+8], 0   ; ebp
    mov dword [edi+12], 0
    mov dword [edi+16], 0
    mov dword [edi+20], 0
    mov dword [edi+24], 0
    mov dword [edi+28], 0
    mov dword [edi+32], 0
    mov dword [edi+36], TASK_READY
    inc dword [sched_task_count]
    mov eax, 1
    ret
.fail:
    xor eax, eax
    ret



scheduler_block_current:
    mov eax, [sched_current]
    mov edi, sched_tcbs
    imul ecx, eax, TCB_SIZE
    add edi, ecx
    mov dword [edi+36], TASK_BLOCKED
    ret

scheduler_wake_task:
    ; EAX = tid
    cmp eax, [sched_task_count]
    jae .ret
    mov edi, sched_tcbs
    imul ecx, eax, TCB_SIZE
    add edi, ecx
    cmp dword [edi+36], TASK_BLOCKED
    jne .ret
    mov dword [edi+36], TASK_READY
.ret:
    ret

%endif
