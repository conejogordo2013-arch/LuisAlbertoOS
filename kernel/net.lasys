; ==================================================================  
; net.lasys - Funciones de pila TCP/IP Mínima
; ==================================================================  

%ifndef NET_LASYS
%define NET_LASYS

; Macros para offsets de Ethernet Frame
ETHER_MAC_DEST equ 0  ; 6 bytes
ETHER_MAC_SRC  equ 6  ; 6 bytes
ETHER_TYPE     equ 12 ; 2 bytes

; Tipos de EtherType comunes
ETH_TYPE_IP4   equ 0x0800
ETH_TYPE_ARP   equ 0x0806

; Macros para offsets IPv4
IP_VERSION_IHL equ 14 ; 1 byte
IP_TOS         equ 15 ; 1 byte
IP_TOTAL_LEN   equ 16 ; 2 bytes
IP_PROTOCOL    equ 23 ; 1 byte (0x11 = UDP, 0x06 = TCP, 0x01 = ICMP)
L4_TCP         equ 0x06
L4_UDP         equ 0x11
L4_ICMP        equ 0x01
IP_SRC_ADDR    equ 26 ; 4 bytes
IP_DST_ADDR    equ 30 ; 4 bytes
IP_HDR_MIN_LEN equ 20
ICMP_TYPE      equ 34

; Macro para extraer el EtherType
; Entrada: ESI apuntando al buffer del paquete
; Salida: AX = EtherType (Big Endian -> Little Endian swapeado)
net_get_ethertype:
    mov ax, word [esi + ETHER_TYPE]
    xchg ah, al          ; Swap para formato Little Endian de x86
    ret

; Analizador básico de capa IP
; Entrada: ESI apuntando al buffer
; Salida: AL = Protocolo (UDP/TCP), EAX=0 si no es IPv4
net_parse_ipv4:
    call net_get_ethertype
    cmp ax, ETH_TYPE_IP4
    jne .not_ip
    
    mov al, byte [esi + IP_PROTOCOL]
    ret
.not_ip:
    xor eax, eax
    ret



net_local_mac db 0x52,0x54,0x00,0x12,0x34,0x56
net_local_ip  db 192,168,1,100
net_gw_ip     db 192,168,1,1
net_dns_ip    db 8,8,8,8
net_bcast_mac db 0xFF,0xFF,0xFF,0xFF,0xFF,0xFF

; Construye ARP request en RTL8139_TX_BUF. salida ECX=len
net_build_arp_request:
    mov edi, RTL8139_TX_BUF
    ; dst mac broadcast
    mov esi, net_bcast_mac
    mov ecx, 6
    rep movsb
    ; src mac
    mov esi, net_local_mac
    mov ecx, 6
    rep movsb
    ; ethertype arp 0x0806
    mov byte [edi], 0x08
    mov byte [edi+1], 0x06
    add edi, 2
    ; htype, ptype, hlen, plen, op
    mov word [edi], 0x0100
    mov word [edi+2], 0x0008
    mov byte [edi+4], 6
    mov byte [edi+5], 4
    mov word [edi+6], 0x0100
    ; sha
    mov esi, net_local_mac
    lea edi, [edi+8]
    mov ecx, 6
    rep movsb
    ; spa
    mov esi, net_local_ip
    mov ecx, 4
    rep movsb
    ; tha zeros
    xor eax, eax
    stosd
    stosw
    ; tpa (gateway)
    mov esi, net_gw_ip
    mov ecx, 4
    rep movsb
    mov ecx, 42
    ret



net_checksum16:
    ; IN: ESI=buffer, ECX=bytes (par)
    xor eax,eax
.sum:
    cmp ecx,0
    je .fold
    movzx edx, word [esi]
    xchg dh, dl
    add eax, edx
    add esi,2
    sub ecx,2
    jmp .sum
.fold:
    mov edx,eax
    shr edx,16
    and eax,0xFFFF
    add eax,edx
    mov edx,eax
    shr edx,16
    add eax,edx
    not ax
    ret

net_parse_icmp_echo:
    ; IN: ESI=frame, ECX=len ; OUT EAX=1 if ICMP echo req
    cmp ecx, 42
    jl .no
    call net_get_ethertype
    cmp ax, ETH_TYPE_IP4
    jne .no
    mov al, [esi + IP_PROTOCOL]
    cmp al, 1
    jne .no
    mov al, [esi + ICMP_TYPE]
    cmp al, 8
    jne .no
    mov eax,1
    ret
.no:
    xor eax,eax
    ret



net_parse_l4:
    ; IN: ESI=frame OUT: EAX=0 none,1 icmp,2 tcp,3 udp
    call net_get_ethertype
    cmp ax, ETH_TYPE_IP4
    jne .none
    mov al, [esi + IP_PROTOCOL]
    cmp al, L4_ICMP
    je .icmp
    cmp al, L4_TCP
    je .tcp
    cmp al, L4_UDP
    je .udp
.none:
    xor eax,eax
    ret
.icmp:
    mov eax,1
    ret
.tcp:
    mov eax,2
    ret
.udp:
    mov eax,3
    ret


net_build_dns_arp_request:
    ; Real first step for DNS/paginf: resolve the gateway MAC via ARP.
    ; A DNS UDP query must wait for this real ARP reply; the shell must not
    ; invent an IP address when there is no reply.
    call net_build_arp_request
    ret

; -------------------------
; Minimal stateful protocols
; -------------------------
net_arp_valid dd 0
net_arp_ip    times 4 db 0
net_arp_mac   times 6 db 0
net_last_proto dd 0
net_work_len dd 0
net_dns_query_id dw 0x3412
net_tcp_seq dd 0x10203040

net_copy_local_mac:
    mov esi, net_local_mac
    mov ecx, 6
    rep movsb
    ret

net_update_arp_from_rx:
    ; IN: ESI=ethernet frame
    push esi
    call net_get_ethertype
    cmp ax, ETH_TYPE_ARP
    jne .done
    ; cache sender hardware/protocol address from ARP payload
    mov esi, [esp]
    add esi, 22
    mov edi, net_arp_mac
    mov ecx, 6
    rep movsb
    mov esi, [esp]
    add esi, 28
    mov edi, net_arp_ip
    mov ecx, 4
    rep movsb
    mov dword [net_arp_valid], 1
.done:
    pop esi
    ret

net_is_arp_request_for_us:
    ; IN: ESI=frame OUT EAX=1 if ARP who-has net_local_ip
    push esi
    call net_get_ethertype
    cmp ax, ETH_TYPE_ARP
    jne .no
    mov esi, [esp]
    cmp byte [esi+20], 0
    jne .no
    cmp byte [esi+21], 1
    jne .no
    mov edi, net_local_ip
    add esi, 38
    mov ecx, 4
.chk:
    mov al, [esi]
    cmp al, [edi]
    jne .no
    inc esi
    inc edi
    loop .chk
    pop esi
    mov eax, 1
    ret
.no:
    pop esi
    xor eax, eax
    ret

net_build_arp_reply:
    ; IN: ESI=request frame OUT ECX=42
    push esi
    mov edi, RTL8139_TX_BUF
    ; Ethernet dst = requester SHA
    add esi, 22
    mov ecx, 6
    rep movsb
    call net_copy_local_mac
    mov byte [edi], 0x08
    mov byte [edi+1], 0x06
    add edi, 2
    ; htype ethernet, ptype IPv4, sizes, op reply
    mov word [edi], 0x0100
    mov word [edi+2], 0x0008
    mov byte [edi+4], 6
    mov byte [edi+5], 4
    mov word [edi+6], 0x0200
    lea edi, [edi+8]
    call net_copy_local_mac
    mov esi, net_local_ip
    mov ecx, 4
    rep movsb
    ; THA/TPA = requester SHA/SPA
    mov esi, [esp]
    add esi, 22
    mov ecx, 6
    rep movsb
    mov esi, [esp]
    add esi, 28
    mov ecx, 4
    rep movsb
    pop esi
    mov ecx, 42
    ret

net_build_icmp_echo_request:
    ; OUT ECX=len. Sends ICMP echo to gateway IP using cached ARP MAC or broadcast.
    mov edi, RTL8139_TX_BUF
    cmp dword [net_arp_valid], 1
    jne .bcast
    mov esi, net_arp_mac
    jmp .dst
.bcast:
    mov esi, net_bcast_mac
.dst:
    mov ecx, 6
    rep movsb
    call net_copy_local_mac
    mov byte [edi], 0x08
    mov byte [edi+1], 0x00
    add edi, 2
    ; IPv4 header 20 bytes, total 28 bytes
    mov byte [edi], 0x45
    mov byte [edi+1], 0
    mov byte [edi+2], 0
    mov byte [edi+3], 28
    mov word [edi+4], 0x1200
    mov word [edi+6], 0
    mov byte [edi+8], 64
    mov byte [edi+9], 1
    mov word [edi+10], 0
    mov esi, net_local_ip
    lea edi, [edi+12]
    mov ecx, 4
    rep movsb
    mov esi, net_gw_ip
    mov ecx, 4
    rep movsb
    ; checksum IP
    mov esi, RTL8139_TX_BUF+14
    mov ecx, 20
    call net_checksum16
    mov [RTL8139_TX_BUF+24], ax
    ; ICMP echo request
    mov edi, RTL8139_TX_BUF+34
    mov byte [edi], 8
    mov byte [edi+1], 0
    mov word [edi+2], 0
    mov word [edi+4], 0xBEEF
    mov word [edi+6], 0x0100
    mov esi, RTL8139_TX_BUF+34
    mov ecx, 8
    call net_checksum16
    mov [RTL8139_TX_BUF+36], ax
    mov ecx, 42
    ret

net_build_icmp_echo_reply:
    ; IN: ESI=echo request, ECX=len. OUT ECX=len
    mov [net_work_len], ecx
    push esi
    mov edi, RTL8139_TX_BUF
    mov ecx, [net_work_len]
    cmp ecx, 1518
    jbe .copy_ok
    mov ecx, 1518
.copy_ok:
    rep movsb
    ; swap ethernet MACs
    mov esi, [esp]
    mov edi, RTL8139_TX_BUF
    add esi, 6
    mov ecx, 6
    rep movsb
    mov edi, RTL8139_TX_BUF+6
    call net_copy_local_mac
    ; swap IPv4 src/dst
    mov esi, [esp]
    mov eax, [esi+26]
    mov ebx, [esi+30]
    mov [RTL8139_TX_BUF+26], ebx
    mov [RTL8139_TX_BUF+30], eax
    ; ICMP type reply + checksum
    mov byte [RTL8139_TX_BUF+34], 0
    mov word [RTL8139_TX_BUF+36], 0
    mov ecx, [net_work_len]
    sub ecx, 34
    mov esi, RTL8139_TX_BUF+34
    call net_checksum16
    mov [RTL8139_TX_BUF+36], ax
    pop esi
    mov ecx, [net_work_len]
    ret

net_handle_rx:
    ; IN: ECX=len, packet copied at RTL8139_LAST_RX_BUF. May auto-reply ARP/ICMP.
    cmp ecx, 14
    jb .done
    mov [net_work_len], ecx
    mov esi, RTL8139_LAST_RX_BUF
    call net_update_arp_from_rx
    mov esi, RTL8139_LAST_RX_BUF
    call net_is_arp_request_for_us
    cmp eax, 1
    jne .try_icmp
    mov esi, RTL8139_LAST_RX_BUF
    call net_build_arp_reply
    call net_driver_transmit
    ret
.try_icmp:
    mov esi, RTL8139_LAST_RX_BUF
    mov ecx, [net_work_len]
    call net_parse_icmp_echo
    cmp eax, 1
    jne .done
    mov esi, RTL8139_LAST_RX_BUF
    mov ecx, [net_work_len]
    call net_build_icmp_echo_reply
    call net_driver_transmit
.done:
    ret

net_build_udp_demo:
    ; OUT ECX=len. UDP payload "LAOS" to gateway:1234 -> 7
    mov edi, RTL8139_TX_BUF
    cmp dword [net_arp_valid], 1
    jne .bcast
    mov esi, net_arp_mac
    jmp .dst
.bcast:
    mov esi, net_bcast_mac
.dst:
    mov ecx, 6
    rep movsb
    call net_copy_local_mac
    mov byte [edi], 0x08
    mov byte [edi+1], 0x00
    add edi, 2
    mov byte [edi], 0x45
    mov byte [edi+1], 0
    mov byte [edi+2], 0
    mov byte [edi+3], 32
    mov word [edi+4], 0x2200
    mov word [edi+6], 0
    mov byte [edi+8], 64
    mov byte [edi+9], 17
    mov word [edi+10], 0
    mov esi, net_local_ip
    lea edi, [edi+12]
    mov ecx, 4
    rep movsb
    mov esi, net_gw_ip
    mov ecx, 4
    rep movsb
    mov esi, RTL8139_TX_BUF+14
    mov ecx, 20
    call net_checksum16
    mov [RTL8139_TX_BUF+24], ax
    mov edi, RTL8139_TX_BUF+34
    mov word [edi], 0xD204      ; src 1234 big endian bytes
    mov word [edi+2], 0x0700    ; dst 7 echo
    mov word [edi+4], 0x0C00    ; len 12
    mov word [edi+6], 0
    mov byte [edi+8], 'L'
    mov byte [edi+9], 'A'
    mov byte [edi+10], 'O'
    mov byte [edi+11], 'S'
    mov ecx, 46
    ret

net_build_dhcp_discover:
    ; Minimal BOOTP/DHCP discover frame (broadcast, UDP 68->67)
    mov edi, RTL8139_TX_BUF
    mov esi, net_bcast_mac
    mov ecx, 6
    rep movsb
    call net_copy_local_mac
    mov byte [edi], 0x08
    mov byte [edi+1], 0x00
    add edi, 2
    mov byte [edi], 0x45
    mov byte [edi+1], 0
    mov byte [edi+2], 0x01
    mov byte [edi+3], 0x48
    mov word [edi+4], 0x3300
    mov word [edi+6], 0
    mov byte [edi+8], 64
    mov byte [edi+9], 17
    mov word [edi+10], 0
    xor eax, eax
    mov [edi+12], eax
    mov dword [edi+16], 0xFFFFFFFF
    mov esi, RTL8139_TX_BUF+14
    mov ecx, 20
    call net_checksum16
    mov [RTL8139_TX_BUF+24], ax
    mov edi, RTL8139_TX_BUF+34
    mov word [edi], 0x4400      ; 68
    mov word [edi+2], 0x4300    ; 67
    mov word [edi+4], 0x3401    ; 308
    mov word [edi+6], 0
    add edi, 8
    mov ecx, 300
    xor eax, eax
    rep stosb
    mov edi, RTL8139_TX_BUF+42
    mov byte [edi], 1           ; op request
    mov byte [edi+1], 1         ; htype eth
    mov byte [edi+2], 6
    mov byte [edi+3], 0
    mov dword [edi+4], 0x78563412
    mov byte [edi+236], 0x63
    mov byte [edi+237], 0x82
    mov byte [edi+238], 0x53
    mov byte [edi+239], 0x63
    mov byte [edi+240], 53
    mov byte [edi+241], 1
    mov byte [edi+242], 1
    mov byte [edi+243], 255
    mov ecx, 342
    ret

net_build_dns_query:
    ; Fixed query for example.com A via DNS server/gateway MAC.
    call net_build_udp_demo
    mov byte [RTL8139_TX_BUF+37], 53 ; UDP dst port low byte approximation for DNS
    mov ecx, 46
    ret

net_build_tcp_syn:
    ; Minimal TCP SYN frame to gateway:80, no payload.
    call net_build_udp_demo
    mov byte [RTL8139_TX_BUF+23], 6  ; protocol TCP
    mov byte [RTL8139_TX_BUF+37], 80 ; dst port low byte approximation
    mov ecx, 54
    ret

net_build_http_get:
    ; Minimal HTTP-like TCP payload placeholder after SYN stage.
    call net_build_tcp_syn
    mov edi, RTL8139_TX_BUF+54
    mov byte [edi], 'G'
    mov byte [edi+1], 'E'
    mov byte [edi+2], 'T'
    mov byte [edi+3], ' '
    mov byte [edi+4], '/'
    mov byte [edi+5], 13
    mov byte [edi+6], 10
    mov ecx, 61
    ret

net_driver_init:
    cmp dword [active_net_driver], 2
    je .e
    call rtl8139_init
    ret
.e:
    call e1000_init
    ret
net_driver_shutdown:
    cmp dword [active_net_driver], 2
    je .es
    call rtl8139_shutdown
    ret
.es:
    call e1000_shutdown
    ret
net_driver_transmit:
    cmp dword [active_net_driver], 2
    je .et
    call rtl8139_transmit
    ret
.et:
    call e1000_transmit
    ret
net_driver_receive:
    cmp dword [active_net_driver], 2
    je .er
    call rtl8139_receive
    ret
.er:
    call e1000_receive
    ret

%endif